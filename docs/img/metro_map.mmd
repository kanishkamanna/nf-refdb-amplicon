%%metro title: nf-refdb-amplicon
%%metro style: dark
%%metro line: silva   | SSU: SILVA        | #0570b0
%%metro line: gtdb    | SSU: GTDB         | #2db572
%%metro line: rdp     | SSU: RDP          | #f5c542
%%metro line: custom  | ESS: Custom files | #9e9e9e
%%metro line: ncbi    | ESS: NCBI         | #e63946
%%metro line: unite   | ESS: UNITE        | #7b2d3b
%%metro line: midori2 | ESS: MIDORI2      | #c792ea
%%metro line: pr2     | ESS: PR2          | #00acc1
%%metro files: custom_in | User .qza
%%metro dir: ssu_out | SSU classifiers
%%metro dir: ess_out | ESS database
%%metro line_order: span
%%metro compact_offsets: true
%%metro grid: ssu_acquire | 0,0
%%metro grid: ssu_curate  | 1,0
%%metro grid: ssu_train   | 2,0
%%metro grid: ess_acquire | 0,1
%%metro grid: ess_seed    | 1,1
%%metro grid: ess_iter    | 2,1

graph LR
    subgraph ssu_acquire [SSU: acquire]
        %%metro exit: right | silva, gtdb, rdp
        get_silva[GET SILVA]
        get_gtdb[GET GTDB]
        get_rdp[GET RDP]
        import_rdp[IMPORT RDP]
        get_rdp -->|rdp| import_rdp
    end

    subgraph ssu_curate [SSU: curate]
        %%metro entry: left | silva, gtdb, rdp
        %%metro exit: right | silva, gtdb, rdp
        full_derep[FULL DEREP]
        full_cull[FULL CULL]
        amp_extract[AMP REG EXTRACT]
        amp_derep[AMP DEREP]
        amp_cull[AMP CULL]
        full_derep -->|silva,gtdb,rdp| full_cull
        full_derep -->|silva,gtdb,rdp| amp_extract
        amp_extract -->|silva,gtdb,rdp| amp_derep
        amp_derep -->|silva,gtdb,rdp| amp_cull
    end

    subgraph ssu_train [SSU: train]
        %%metro entry: left | silva, gtdb, rdp
        full_train[FULL TRAIN]
        amp_train[AMP TRAIN]
        ssu_out[ ]
        full_train -->|silva,gtdb,rdp| ssu_out
        amp_train -->|silva,gtdb,rdp| ssu_out
    end

    subgraph ess_acquire [ESS: acquire]
        %%metro exit: right | custom, ncbi, unite, midori2, pr2
        custom_in[ ]
        get_ncbi[GET NCBI DATA]
        get_unite[GET UNITE DATA]
        get_midori2[GET MIDORI2 DATA]
        extract_coll[EXTRACT FROM COLLECTION]
        get_pr2[GET PR2 DATA]
        get_midori2 -->|midori2| extract_coll
    end

    subgraph ess_seed [ESS: seed segments]
        %%metro entry: left | custom, ncbi, unite, midori2, pr2
        %%metro exit: right | custom, ncbi, unite, midori2, pr2
        extract_reads[EXTRACT READS]
        ess_setup[ESS SETUP]
        extract_reads -->|ncbi,unite,midori2,pr2| ess_setup
    end

    subgraph ess_iter [ESS: iterate and train]
        %%metro entry: left | custom, ncbi, unite, midori2, pr2
        ess_iterate[ESS ITERATE]
        ess_train[ESS TRAIN CLASSIFIER]
        ess_out[ ]
        ess_iterate -->|custom,ncbi,unite,midori2,pr2| ess_train
        ess_train -->|custom,ncbi,unite,midori2,pr2| ess_out
    end

    %% inter-section edges
    get_silva -->|silva| full_derep
    get_gtdb -->|gtdb| full_derep
    import_rdp -->|rdp| full_derep

    full_cull -->|silva,gtdb,rdp| full_train
    amp_cull -->|silva,gtdb,rdp| amp_train

    custom_in -->|custom| extract_reads
    get_ncbi -->|ncbi| extract_reads
    get_unite -->|unite| extract_reads
    extract_coll -->|midori2| extract_reads
    get_pr2 -->|pr2| extract_reads

    ess_setup -->|custom,ncbi,unite,midori2,pr2| ess_iterate