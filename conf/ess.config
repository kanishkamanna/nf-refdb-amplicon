/*
========================================================================================
    ESS CONFIG
========================================================================================
    Configuration for the Extract Sequence Segments (ESS) pipeline.
----------------------------------------------------------------------------------------
*/

process {

    withLabel: 'process_long' {
        cpus = { Math.min(4 * task.attempt, params.max_cpus as int) }
        memory = {
            def requested = 16.GB * task.attempt
            def limit = params.max_memory as MemoryUnit
            requested < limit ? requested : limit
        }
        time = {
            def requested = 12.h * task.attempt
            def limit = params.max_time as Duration
            requested < limit ? requested : limit
        }
    }

    withLabel: 'ess_setup' {
        cpus   = 1
        memory = {
            def requested = 2.GB * task.attempt
            def limit = params.max_memory as MemoryUnit
            requested < limit ? requested : limit
        }
        time = {
            def requested = 1.h * task.attempt
            def limit = params.max_time as Duration
            requested < limit ? requested : limit
        }
    }

    withLabel: 'ess_iterate' {
        cpus = { Math.min(8 * task.attempt, params.max_cpus as int) }
        memory = {
            def requested = 16.GB * task.attempt
            def limit = params.max_memory as MemoryUnit
            requested < limit ? requested : limit
        }
        time = {
            def requested = 4.h * task.attempt
            def limit = params.max_time as Duration
            requested < limit ? requested : limit
        }
    }

    withLabel: 'train_classifier' {
        cpus = { Math.min(8 * task.attempt, params.max_cpus as int) }
        memory = {
            def requested = 32.GB * task.attempt
            def limit = params.max_memory as MemoryUnit
            requested < limit ? requested : limit
        }
        time = {
            def requested = 8.h * task.attempt
            def limit = params.max_time as Duration
            requested < limit ? requested : limit
        }
    }
}