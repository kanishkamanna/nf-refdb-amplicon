/*
========================================================================================
    ESS CONFIG
========================================================================================
    Configuration for the Extract Sequence Segments (ESS) pipeline.
----------------------------------------------------------------------------------------
*/

// TODO: Support variable perc_identity per iteration via an iteration_schedule = [[2, 0.7], [1, 0.8], [1, 0.9]]
//      This would run 2 iterations at 70%, 1 iteration at 80%, and 1 iteration at 90% identity

/*
----------------------------------------------------------------------------------------
    PARAMETERS
----------------------------------------------------------------------------------------
*/

params {

    ess {
        // Data source
        // Options: 'custom', 'ncbi', 'unite', 'midori2', 'pr2'
        source              = 'custom'

        // Input files (required when source is 'custom')
        seqs                = null
        taxa                = null
        seqsegs             = null

        // Database and region identifiers
        db                  = 'refdb'
        amp_seg             = 'segment'

        // Iteration settings
        max_iter            = 2
        train_classifier    = true

        // Extract seq segments parameters
        perc_identity       = '0.7'
        min_seq_len         = '10'
        max_seq_len         = '50000'

        // Primer sequences for initial segment extraction
        // Required when source is not 'custom' and seqsegs is not provided
        fwd_primer          = null
        rev_primer          = null
        extract_min_length  = 10
        extract_max_length  = 0

        // NCBI-specific (when source is 'ncbi')
        ncbi_query          = ''

        // UNITE-specific (when source is 'unite')
        unite_version       = '2025-02-19'
        unite_taxon_group   = 'eukaryotes'
        unite_cluster_id    = 'dynamic'
        unite_singletons    = false

        // MIDORI2-specific (when source is 'midori2')
        midori2_version     = ''
        midori2_target_gene = 'COI'

        // PR2-specific (when source is 'pr2')
        pr2_version         = ''
    }
}


/*
----------------------------------------------------------------------------------------
    PROCESS CONFIGURATION
----------------------------------------------------------------------------------------
*/

process {

    withLabel: 'process_long' {
        cpus   = { Math.min(4 * task.attempt, params.max_cpus as int) }
        memory = { 16.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }

    withLabel: 'ess_setup' {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }

    withLabel: 'ess_extseqsegs' {
        cpus   = { params.max_cpus as int }
        memory = { 24.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    withLabel: 'ess_iterate' {
        cpus   = { Math.min(8 * task.attempt, params.max_cpus as int) }
        memory = { 16.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    withLabel: 'train_classifier' {
        cpus   = 1
        memory = { 14.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }

    withName: '.*ESS.*' {
        publishDir = [
            path: "${params.outdir}/ess",
            mode: params.publish_dir_mode,
        ]
    }
}

/*
========================================================================================
    THE END
========================================================================================
*/