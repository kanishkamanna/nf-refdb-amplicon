/*
========================================================================================
    ESS CONFIG
========================================================================================
    Configuration for the Extract Sequence Segments (ESS) pipeline.
----------------------------------------------------------------------------------------
*/

params {

    ess {
        // Input files (required)
        seqs    = null    // Path to reference sequences .qza
        taxa    = null    // Path to taxonomy .qza
        seqsegs = null    // Path to initial segment sequences .qza

        // Database and region identifiers (for output naming)
        db      = 'refdb'
        amp_seg = 'segment'

        // Iteration settings
        max_iter         = 2
        train_classifier = true

        // Extract seq segments parameters
        perc_identity = '0.7'
        min_seq_len   = '10'
    }
}

process {

    withLabel: 'ess_setup' {
        cpus   = 1
        memory = {
            def requested = 2.GB * task.attempt
            def limit = params.max_memory as MemoryUnit
            requested.toBytes() > limit.toBytes() ? limit : requested
        }
        time = {
            def requested = 1.h * task.attempt
            def limit = params.max_time as Duration
            requested > limit ? limit : requested
        }
        queue = params.queue
    }

    withLabel: 'ess_iterate' {
        //maxForks = 1
        cpus = { params.max_cpus ? Math.min(8 * task.attempt, params.max_cpus as int) : 8 * task.attempt }
        memory = {
            def requested = 16.GB * task.attempt
            def limit = params.max_memory as MemoryUnit
            requested.toBytes() > limit.toBytes() ? limit : requested
        }
        time = {
            def requested = 4.h * task.attempt
            def limit = params.max_time as Duration
            requested > limit ? limit : requested
        }
        queue = params.queue
    }
}