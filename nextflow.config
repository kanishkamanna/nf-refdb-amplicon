/*
========================================================================================
    nf-refdb-amplicon Nextflow config file
========================================================================================
*/

// Manifest
manifest {
    name            = 'nf-refdb-amplicon'
    author          = 'Kanishka Manna, Michael S. Robeson'
    homePage        = 'https://github.com/mikerobeson/nf-refdb-amplicon'
    description     = 'Nextflow pipeline for generating reference databases for amplicon sequences'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=24.04.0'
    version         = '0.2.3'
}

// Default parameters
params {
    // Top-level
    help             = false
    pipeline_type    = null
    outdir           = './results'
    publish_dir_mode = 'copy'

    // Conda
    qiime_conda_env = null

    // SSU pipeline parameters
    ssu {
        databases                 = 'silva'
        build_full_classifier     = true
        build_amplicon_classifier = true
        fwd_primer                = null
        rev_primer                = null
        min_len                   = 100
        max_len                   = 600
        ncbi_tax_includes         = ''
        ncbi_tax_excludes         = ''
    }

    // ESS pipeline parameters
    ess {
        // Data source
        source              = 'custom'

        // Custom input files
        seqs                = null
        taxa                = null
        seqsegs             = null

        // Database and region identifiers
        db                  = 'refdb'
        amp_seg             = 'segment'

        // Iteration settings
        max_iter            = 2
        train_classifier    = true

        // Extract seq segments parameters
        perc_identity       = '0.7'
        min_seq_len         = '10'

        // NCBI
        ncbi_query          = ''

        // UNITE
        unite_version       = '10.0'
        unite_taxon_group   = 'eukaryotes'
        unite_cluster_id    = 'dynamic'
        unite_singletons    = false

        // MIDORI2
        midori2_version     = ''
        midori2_target_gene = 'COI'

        // PR2
        pr2_version         = ''
    }

    // Resource limits
    max_memory = '64.GB'
    max_cpus   = 4
    max_time   = '72.h'
}

/*
========================================================================================
    PROFILES
========================================================================================
*/

profiles {
    local {
        process.executor = 'local'
    }

    cluster {
        process.executor = 'slurm'
    }

    docker {
        docker.enabled = true
        conda.enabled  = false
    }

    conda {
        conda.enabled  = true
        docker.enabled = false
    }
}

/*
========================================================================================
    LOAD ADDITIONAL CONFIGS
========================================================================================
*/

includeConfig 'conf/ssu.config'
includeConfig 'conf/ess.config'

/*
========================================================================================
    THE END
========================================================================================
*/