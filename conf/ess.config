/*
========================================================================================
    ESS CONFIG
========================================================================================
    Configuration for the Extract Sequence Segments (ESS) pipeline.

    The ESS pipeline automates the construction of amplicon reference
    databases using RESCRIPt's iterative extract-seq-segments approach.
----------------------------------------------------------------------------------------
*/

params {

    ess {
        // NCBI query string for downloading reference sequences
        ncbi_query = null   // Required: e.g., "txid35493[ORGN] AND (trnL OR tRNA-Leu)..."

        // Taxonomic ranks to extract
        ranks = 'kingdom phylum class order family genus species'

        // Primer sequences for initial seed extraction
        fw_primer = null    // Required: forward primer sequence
        rv_primer = null    // Required: reverse primer sequence

        // Database and region identifiers
        db      = 'refdb'
        amp_seg = 'segment'

        // Iteration settings
        max_iter         = 3      // Maximum number of iterations
        train_classifier = true   // Train classifier after iterations

        // Extract seq segments parameters
        perc_identity = '0.7'
        min_seq_len   = '10'

        // These are set automatically by the pipeline after Steps 1-2
        // Users should NOT set these manually
        ref_seqs = null
        ref_taxa = null
    }
}

/*
----------------------------------------------------------------------------------------
    PROCESS CONFIGURATION
----------------------------------------------------------------------------------------
*/

process {

    withName: '.*ESS.*' {
        publishDir = [
            path: "${params.outdir}/ess",
            mode: params.publish_dir_mode,
        ]
    }

    withLabel: 'ess_extseqsegs' {
        cpus = { params.max_cpus ? Math.min(8 * task.attempt, params.max_cpus as int) : 8 * task.attempt }
        memory = {
            def requested = 24.GB * task.attempt
            def limit = params.max_memory as MemoryUnit
            requested.toBytes() > limit.toBytes() ? limit : requested
        }
        time = {
            def requested = 4.h * task.attempt
            def limit = params.max_time as Duration
            requested > limit ? limit : requested
        }
        queue = params.queue
    }

    withLabel: 'ess_download' {
        cpus   = 1
        memory = {
            def requested = 4.GB * task.attempt
            def limit = params.max_memory as MemoryUnit
            requested.toBytes() > limit.toBytes() ? limit : requested
        }
        time = {
            def requested = 2.h * task.attempt
            def limit = params.max_time as Duration
            requested > limit ? limit : requested
        }
        queue = params.queue
    }
}

/*
========================================================================================
    THE END
========================================================================================
*/