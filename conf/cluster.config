/*
========================================================================================
    CLUSTER CONFIG
========================================================================================
    Resource allocations optimized for HPC/SLURM execution.
    These override base.config defaults when running with -profile cluster.

    Resources scale with each retry attempt and are capped by
    params.max_memory, params.max_cpus, params.max_time.
----------------------------------------------------------------------------------------
*/

process {

    // SSU tasks
    withLabel: 'derep' {
        cpus   = { params.max_cpus ? Math.min(8 * task.attempt, params.max_cpus as int) : 8 * task.attempt }
        memory = {
            def requested = 16.GB * task.attempt
            def limit = params.max_memory as MemoryUnit
            requested.toBytes() > limit.toBytes() ? limit : requested
        }
        time = {
            def requested = 4.h * task.attempt
            def limit = params.max_time as Duration
            requested > limit ? limit : requested
        }
        queue = params.queue
    }

    withLabel: 'amp_reg_extract' {
        cpus   = { params.max_cpus ? Math.min(8 * task.attempt, params.max_cpus as int) : 8 * task.attempt }
        memory = {
            def requested = 16.GB * task.attempt
            def limit = params.max_memory as MemoryUnit
            requested.toBytes() > limit.toBytes() ? limit : requested
        }
        time = {
            def requested = 8.h * task.attempt
            def limit = params.max_time as Duration
            requested > limit ? limit : requested
        }
        queue = params.queue
    }

    withLabel: 'train_classifier' {
        cpus   = 1
        memory = {
            def requested = 48.GB * task.attempt
            def limit = params.max_memory as MemoryUnit
            requested.toBytes() > limit.toBytes() ? limit : requested
        }
        time = {
            def requested = 24.h * task.attempt
            def limit = params.max_time as Duration
            requested > limit ? limit : requested
        }
        queue = params.queue
    }

    withLabel: 'cull' {
        cpus   = { params.max_cpus ? Math.min(4 * task.attempt, params.max_cpus as int) : 4 * task.attempt }
        memory = {
            def requested = 4.GB * task.attempt
            def limit = params.max_memory as MemoryUnit
            requested.toBytes() > limit.toBytes() ? limit : requested
        }
        time = {
            def requested = 4.h * task.attempt
            def limit = params.max_time as Duration
            requested > limit ? limit : requested
        }
        queue = params.queue
    }

    withLabel: 'tabseqs' {
        cpus   = 1
        memory = {
            def requested = 4.GB * task.attempt
            def limit = params.max_memory as MemoryUnit
            requested.toBytes() > limit.toBytes() ? limit : requested
        }
        time = {
            def requested = 2.h * task.attempt
            def limit = params.max_time as Duration
            requested > limit ? limit : requested
        }
        queue = params.queue
    }

    withLabel: 'get_silva|get_gtdb|get_rdp' {
        cpus   = 1
        memory = {
            def requested = 4.GB * task.attempt
            def limit = params.max_memory as MemoryUnit
            requested.toBytes() > limit.toBytes() ? limit : requested
        }
        time = {
            def requested = 2.h * task.attempt
            def limit = params.max_time as Duration
            requested > limit ? limit : requested
        }
        queue = params.queue
    }

    // ESS tasks
    withLabel: 'ess_setup' {
        cpus   = 1
        memory = {
            def requested = 4.GB * task.attempt
            def limit = params.max_memory as MemoryUnit
            requested < limit ? requested : limit
        }
        time = {
            def requested = 1.h * task.attempt
            def limit = params.max_time as Duration
            requested < limit ? requested : limit
        }
        queue = params.queue
    }

    withLabel: 'ess_extseqsegs' {
        cpus   = { params.max_cpus as int }
        memory = {
            def requested = 32.GB * task.attempt
            def limit = params.max_memory as MemoryUnit
        requested < limit ? requested : limit
        }
        time = {
            def requested = 4.h * task.attempt
            def limit = params.max_time as Duration
        requested < limit ? requested : limit
        }
        queue = params.queue
    }

    withLabel: 'ess_iterate' {
        cpus   = { params.max_cpus ? Math.min(8 * task.attempt, params.max_cpus as int) : 8 * task.attempt }
        memory = {
            def requested = 32.GB * task.attempt
            def limit = params.max_memory as MemoryUnit
            requested < limit ? requested : limit
        }
        time = {
            def requested = 8.h * task.attempt
            def limit = params.max_time as Duration
            requested < limit ? requested : limit
        }
        queue = params.queue
    }

    withLabel: 'process_long' {
        cpus   = { params.max_cpus ? Math.min(4 * task.attempt, params.max_cpus as int) : 4 * task.attempt }
        memory = {
            def requested = 16.GB * task.attempt
            def limit = params.max_memory as MemoryUnit
            requested < limit ? requested : limit
        }
        time = {
            def requested = 12.h * task.attempt
            def limit = params.max_time as Duration
            requested < limit ? requested : limit
        }
        queue = params.queue
    }
}

/*
========================================================================================
    THE END
========================================================================================
*/