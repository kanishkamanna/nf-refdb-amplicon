/*
========================================================================================
    SSU CONFIG
========================================================================================
    Configuration for the SSU (16S/18S rRNA gene) pipeline.
    
    Controls:
        - Which databases to build classifiers from
        - Whether to build full-length and/or amplicon classifiers
        - Primer pairs for amplicon region extraction
        - Database-specific download parameters
        - Process publishDir and resource overrides
----------------------------------------------------------------------------------------
*/

/*
----------------------------------------------------------------------------------------
    PARAMETERS
----------------------------------------------------------------------------------------
*/

params {

    // ----------------------------------------------------------
    // Database selection
    // Options: 'silva', 'gtdb', 'rdp'
    // ----------------------------------------------------------
    ssu_databases = ['silva', 'gtdb', 'rdp']

    // ----------------------------------------------------------
    // Classifier options
    // ----------------------------------------------------------
    build_full_classifier     = true
    build_amplicon_classifier = true

    // ----------------------------------------------------------
    // Primer pairs for amplicon region extraction
    //
    // Format: [name, forward_primer, reverse_primer]
    //
    // Note: Some primer-pair combinations may not work if a 
    // primer is towards the end of the full-length SSU sequence,
    // as the primer sequence may not be present at that location.
    // For these cases, use the ESS pipeline instead.
    //
    // Do not use 'full' as a primer pair name — it is reserved.
    // ----------------------------------------------------------
    primer_pairs = [
        // ['27F338R',   'AGAGTTTGATYMTGGCTCAG',  'GCTGCCTCCCGTAGGAGT'],
        // ['27F534R',   'AGAGTTTGATYMTGGCTCAG',  'ATTACCGCGGCTGCTGG'],
        //['357wF805R', 'CCTACGGGNGGCWGCAG',     'GACTACHVGGGTATCTAATCC'],
        //['357wF806R', 'CCTACGGGNGGCWGCAG',     'GGACTACHVGGGTWTCTAAT'],
        ['515F806R',  'GTGYCAGCMGCCGCGGTAA',   'GGACTACNVGGGTWTCTAAT']
        //['515F926R',  'GTGYCAGCMGCCGCGGTAA',   'CCGYCAATTYMTTTRAGTTT'],
        // ['515F944R',  'GTGCCAGCMGCCGCGGTAA',  'GAATTAAACCACATGCTC'],
        // ['939F1378R', 'GAATTGACGGGGGCCCGCACAAG', 'CGGTGTGTACAAGGCCCGGGAACG'],
    ]

    // ----------------------------------------------------------
    // Database-specific parameters
    // ----------------------------------------------------------
    get_silva {
        version = '138.2'
        target  = 'SSURef_NR99'
        ranks   = 'domain phylum class order family genus'
    }

    get_gtdb {
        version = '220.0'
        domain  = 'Both'
        dbtype  = 'SpeciesReps'
    }
}

/*
----------------------------------------------------------------------------------------
    PROCESS CONFIGURATION
----------------------------------------------------------------------------------------
*/

process {

    // ----------------------------------------------------------
    // publishDir: route outputs to database-specific directories
    // ----------------------------------------------------------

    withName: '.*SILVA.*' {
        publishDir = [
            path: "${params.outdir}/silva",
            mode: params.publish_dir_mode,
        ]
    }

    withName: '.*GTDB.*' {
        publishDir = [
            path: "${params.outdir}/gtdb",
            mode: params.publish_dir_mode,
        ]
    }

    withName: '.*RDP.*' {
        publishDir = [
            path: "${params.outdir}/rdp",
            mode: params.publish_dir_mode,
        ]
    }

    // ----------------------------------------------------------
    // Database download processes
    
    // Comment the `executor` line below if your HPC worker nodes
    // can access the internet. This will submit these tasks to
    // your job scheduler. Otherwise, leave uncommented if your
    // HPC can't access the internet and it will the processes
    // with the specified labels on the login / head node.
    // ----------------------------------------------------------

    withLabel: 'get_silva|get_gtdb|get_rdp' {
        executor = 'local'
        cpus     = 1
        memory   = 2.GB
        queue    = params.queue
        time     = 1.h
    }
}

/*
========================================================================================
    THE END
========================================================================================
*/