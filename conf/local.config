/*
========================================================================================
    LOCAL CONFIG
========================================================================================
    Default process resource allocations shared across all pipelines.
    Resources scale with each retry attempt. Retries only occur on
    memory/timeout errors (exit codes 137, 140, 247, etc.).
----------------------------------------------------------------------------------------
*/

/*
----------------------------------------------------------------------------------------
    SHARED PARAMETERS
----------------------------------------------------------------------------------------
*/

params {

    derep {
        mode = 'uniq'
    }

    cull {
        degen = '5'
        hpoly = '8'
    }

    // Resource limits (override from CLI)
    max_memory = 16.GB
    max_cpus   = 4
    max_time   = 48.h
}

/*
----------------------------------------------------------------------------------------
    PROCESS RESOURCES
----------------------------------------------------------------------------------------
*/

process {

    errorStrategy = { task.exitStatus in [137, 140, 104, 134, 139, 247] ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: 'derep' {
        cpus   = { params.max_cpus ? Math.min(4 * task.attempt, params.max_cpus as int) : 4 * task.attempt }
        memory = {
            def requested = 8.GB * task.attempt
            def limit = params.max_memory as MemoryUnit
            requested.toBytes() > limit.toBytes() ? limit : requested
        }
        time   = {
            def requested = 2.h * task.attempt
            def limit = params.max_time as Duration
            requested > limit ? limit : requested
        }
        queue  = params.queue
    }

    withLabel: 'amp_reg_extract' {
        cpus   = { params.max_cpus ? Math.min(4 * task.attempt, params.max_cpus as int) : 4 * task.attempt }
        memory = {
            def requested = 8.GB * task.attempt
            def limit = params.max_memory as MemoryUnit
            requested.toBytes() > limit.toBytes() ? limit : requested
        }
        time   = {
            def requested = 4.h * task.attempt
            def limit = params.max_time as Duration
            requested > limit ? limit : requested
        }
        queue  = params.queue
    }

    withLabel: 'train_classifier' {
        cpus   = 1
        memory = {
            def requested = 16.GB * task.attempt
            def limit = params.max_memory as MemoryUnit
            requested.toBytes() > limit.toBytes() ? limit : requested
        }
        time   = {
            def requested = 8.h * task.attempt
            def limit = params.max_time as Duration
            requested > limit ? limit : requested
        }
        queue  = params.queue
    }

    withLabel: 'cull' {
        cpus   = { params.max_cpus ? Math.min(2 * task.attempt, params.max_cpus as int) : 2 * task.attempt }
        memory = {
            def requested = 2.GB * task.attempt
            def limit = params.max_memory as MemoryUnit
            requested.toBytes() > limit.toBytes() ? limit : requested
        }
        time   = {
            def requested = 2.h * task.attempt
            def limit = params.max_time as Duration
            requested > limit ? limit : requested
        }
        queue  = params.queue
    }

    withLabel: 'tabseqs' {
        cpus   = 1
        memory = {
            def requested = 2.GB * task.attempt
            def limit = params.max_memory as MemoryUnit
            requested.toBytes() > limit.toBytes() ? limit : requested
        }
        time   = {
            def requested = 1.h * task.attempt
            def limit = params.max_time as Duration
            requested > limit ? limit : requested
        }
        queue  = params.queue
    }

    withLabel: 'get_silva|get_gtdb|get_rdp' {
        cpus   = 1
        memory = {
            def requested = 2.GB * task.attempt
            def limit = params.max_memory as MemoryUnit
            requested.toBytes() > limit.toBytes() ? limit : requested
        }
        time   = {
            def requested = 1.h * task.attempt
            def limit = params.max_time as Duration
            requested > limit ? limit : requested
        }
        queue  = params.queue
    }
}

/*
========================================================================================
    THE END
========================================================================================
*/