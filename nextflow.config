/*
========================================================================================
    nf-refdb-amplicon Nextflow config file
========================================================================================
*/

// Plugin declaration
plugins {
    id 'nf-schema@2.7.2'
}

// nf-schema configuration
validation {
    //defaultIgnoreParams = ['ssu', 'ess', 'max_memory', 'max_cpus', 'max_time']
    monochromeLogs      = false
}

// Manifest
manifest {
    name            = 'nf-refdb-amplicon'
    author          = 'Mike Robeson'
    homePage        = 'https://github.com/mikerobeson/nf-refdb-amplicon'
    description     = 'Nextflow pipeline for generating reference databases for amplicon sequences'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=24.04.0'
    version         = '0.2.2'
}

// Default parameters
params {
    // Top-level
    help             = false
    pipeline_type    = null
    outdir           = './results'
    publish_dir_mode = 'copy'

    // Conda
    qiime_conda_env = null

    // SSU pipeline parameters
    ssu {
        databases                 = 'silva'
        build_full_classifier     = true
        build_amplicon_classifier = true
        fwd_primer                = null
        rev_primer                = null
        min_len                   = 100
        max_len                   = 600
        ncbi_tax_includes         = ''
        ncbi_tax_excludes         = ''
    }

    // ESS pipeline parameters
    ess {
        source              = 'custom'
        seqs                = null
        taxa                = null
        seqsegs             = null
        max_iter            = 1
        num_degenerates     = 5
        num_mismatch        = 5
        build_classifier    = false

        // NCBI-specific (when source is 'ncbi')
        ncbi_query          = ''

        // UNITE-specific (when source is 'unite')
        unite_version       = '10.0'
        unite_taxon_group   = 'eukaryotes'
        unite_cluster_id    = 'dynamic'
        unite_singletons    = false

        // MIDORI2-specific (when source is 'midori2')
        midori2_version     = ''
        midori2_target_gene = 'COI'

        // PR2-specific (when source is 'pr2')
        pr2_version         = ''
    }

    // Resource limits
    max_memory = '64.GB'
    max_cpus   = 4
    max_time   = '72.h'
}

/*
========================================================================================
    PROFILES
========================================================================================
*/

profiles {
    local {
        process.executor = 'local'
    }

    cluster {
        process.executor = 'slurm'
    }

    docker {
        docker.enabled = true
        conda.enabled  = false
    }

    conda {
        conda.enabled  = true
        docker.enabled = false
    }
}

/*
========================================================================================
    LOAD ADDITIONAL CONFIGS
========================================================================================
*/

includeConfig 'conf/ssu.config'
includeConfig 'conf/ess.config'

/*
========================================================================================
    THE END
========================================================================================
*/