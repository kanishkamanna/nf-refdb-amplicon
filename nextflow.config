// nextflow.config

nextflow.enable.dsl = 2

// ============================================================
// Pipeline parameters
// ============================================================
params.pipeline_type = null
params.qiime_version = '2026.4'
params.qiime_env     = null   // optional: path to existing env
params.queue         = 'cloud'
params.outdir        = 'results'

// ============================================================
// Auto-detect OS and construct conda YAML URL
// ============================================================
def is_mac     = System.getProperty('os.name').toLowerCase().contains('mac')
def conda_arch = is_mac ? 'osx-64' : 'linux-64'
def qiime_yaml = "https://raw.githubusercontent.com/qiime2/distributions/refs/heads/dev/${params.qiime_version}/qiime2/released/rachis-qiime2-${conda_arch}-conda.yml"

// ============================================================
// Profiles
// ============================================================
profiles {
    local {
        process.executor    = 'local'
        conda.enabled       = true
        conda.cacheDir      = "${HOME}/.nextflow/conda"
        process.conda       = params.qiime_env ?: qiime_yaml
        executor.cpus       = 10
        executor.memory     = '64 GB'
        if (is_mac) {
            conda.createOptions = '--subdir osx-64'
        }
    }
    cluster {
        process.executor         = 'slurm'
        executor.submitRateLimit = '6/1min'
        executor.queueSize       = 20
        process.queue            = params.queue
        conda.enabled            = true
        conda.cacheDir           = "${HOME}/.nextflow/conda"
        process.conda            = params.qiime_env ?: qiime_yaml
    }
}

// ============================================================
// Load pipeline-specific configs
// ============================================================
includeConfig './conf/base.config'
includeConfig './conf/ssu.config'
includeConfig './conf/ess.config'