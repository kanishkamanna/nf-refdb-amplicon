{
    "$schema": "http://json-schema.org/draft-07/schema",
    "$id": "https://raw.githubusercontent.com/mikerobeson/nf-refdb-amplicon/main/nextflow_schema.json",
    "title": "nf-refdb-amplicon pipeline parameters",
    "description": "Nextflow pipeline for generating reference databases for amplicon sequences using RESCRIPt",
    "type": "object",
    "definitions": {
        "pipeline_options": {
            "title": "Pipeline Options",
            "type": "object",
            "properties": {
                "pipeline_type": {
                    "type": "string",
                    "description": "Pipeline to run: 'ssu' or 'ess'",
                    "enum": ["ssu", "ess"]
                },
                "outdir": {
                    "type": "string",
                    "description": "Output directory for results",
                    "default": "./results"
                },
                "publish_dir_mode": {
                    "type": "string",
                    "default": "copy",
                    "description": "Method for publishing output files",
                    "hidden": true
                },
                "help": {
                    "type": ["boolean", "string"],
                    "description": "Show help message",
                    "default": false,
                    "hidden": true
                }
            }
        },
        "conda_options": {
            "title": "Conda Options",
            "type": "object",
            "properties": {
                "qiime_conda_env": {
                    "type": "string",
                    "description": "Path to QIIME 2 conda environment or YAML file"
                }
            }
        },
        "ssu_options": {
            "title": "SSU Pipeline",
            "type": "object",
            "properties": {
                "ssu": {
                    "type": "object",
                    "description": "SSU pipeline parameters",
                    "properties": {
                        "databases": {
                            "type": "string",
                            "default": "silva",
                            "description": "Databases to build"
                        },
                        "build_full_classifier": {
                            "type": "boolean",
                            "default": true,
                            "description": "Build full-length classifier"
                        },
                        "build_amplicon_classifier": {
                            "type": "boolean",
                            "default": true,
                            "description": "Build amplicon classifier"
                        },
                        "fwd_primer": {
                            "type": "string",
                            "description": "Forward primer sequence"
                        },
                        "rev_primer": {
                            "type": "string",
                            "description": "Reverse primer sequence"
                        },
                        "min_len": {
                            "type": "integer",
                            "default": 100,
                            "description": "Minimum amplicon length"
                        },
                        "max_len": {
                            "type": "integer",
                            "default": 600,
                            "description": "Maximum amplicon length"
                        },
                        "ncbi_tax_includes": {
                            "type": "string",
                            "default": "",
                            "description": "Taxa to include for NCBI"
                        },
                        "ncbi_tax_excludes": {
                            "type": "string",
                            "default": "",
                            "description": "Taxa to exclude for NCBI"
                        }
                    }
                }
            }
        },
        "ess_options": {
            "title": "ESS Pipeline",
            "type": "object",
            "properties": {
                "ess": {
                    "type": "object",
                    "description": "ESS pipeline parameters",
                    "properties": {
                        "source": {
                            "type": "string",
                            "default": "local",
                            "description": "Data source",
                            "enum": ["local", "ncbi", "unite", "midori2", "pr2"]
                        },
                        "seqs": {
                            "type": "string",
                            "description": "Path to input sequences (.qza)"
                        },
                        "taxa": {
                            "type": "string",
                            "description": "Path to input taxonomy (.qza)"
                        },
                        "seqsegs": {
                            "type": "string",
                            "description": "Path to sequence segments (.qza)"
                        },
                        "max_iter": {
                            "type": "integer",
                            "default": 1,
                            "description": "Maximum ESS iterations"
                        },
                        "num_degenerates": {
                            "type": "integer",
                            "default": 5,
                            "description": "Degenerates per iteration"
                        },
                        "num_mismatch": {
                            "type": "integer",
                            "default": 5,
                            "description": "Max primer mismatches"
                        },
                        "build_classifier": {
                            "type": "boolean",
                            "default": false,
                            "description": "Build classifier from output"
                        },
                        "ncbi_query": {
                            "type": "string",
                            "default": "",
                            "description": "NCBI Entrez query"
                        },
                        "ncbi_ranks": {
                            "type": "string",
                            "default": "kingdom,phylum,class,order,family,genus,species",
                            "description": "Taxonomic ranks for NCBI"
                        },
                        "unite_version": {
                            "type": "string",
                            "default": "10.0",
                            "description": "UNITE version"
                        },
                        "unite_taxon_group": {
                            "type": "string",
                            "default": "eukaryotes",
                            "description": "UNITE taxon group",
                            "enum": ["fungi", "eukaryotes"]
                        },
                        "midori2_version": {
                            "type": "string",
                            "default": "",
                            "description": "MIDORI2 version"
                        },
                        "midori2_target_gene": {
                            "type": "string",
                            "default": "COI",
                            "description": "MIDORI2 target gene"
                        },
                        "pr2_version": {
                            "type": "string",
                            "default": "",
                            "description": "PR2 version"
                        }
                    }
                }
            }
        },
        "resource_limits": {
            "title": "Resource Limits",
            "type": "object",
            "properties": {
                "max_memory": {
                    "type": "string",
                    "default": "64.GB",
                    "description": "Maximum memory per process",
                    "hidden": true
                },
                "max_cpus": {
                    "type": "integer",
                    "default": 4,
                    "description": "Maximum CPUs per process",
                    "hidden": true
                },
                "max_time": {
                    "type": "string",
                    "default": "72.h",
                    "description": "Maximum time per process",
                    "hidden": true
                }
            }
        }
    },
    "allOf": [
        { "$ref": "#/definitions/pipeline_options" },
        { "$ref": "#/definitions/conda_options" },
        { "$ref": "#/definitions/ssu_options" },
        { "$ref": "#/definitions/ess_options" },
        { "$ref": "#/definitions/resource_limits" }
    ]
}